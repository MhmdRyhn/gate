# Copy to .env (chmod 600) and fill in. Never commit .env or ./secrets.
# Every key can come from any config source (env, files, Kubernetes
# ConfigMap/Secret, Consul, AWS AppConfig). Keys match the Go service.

# --- Compose ---
COMPOSE_PROFILES=bundled-db        # remove to use an external PostgreSQL (e.g. RDS)
DOMAIN=auth.example.com            # public hostname served by Caddy
# APP_IMAGE=123456789012.dkr.ecr.eu-west-1.amazonaws.com/rbac-service-py:1.0.0

# --- Bundled PostgreSQL ---
POSTGRES_USER=rbac_owner           # owner role: migrations only
POSTGRES_PASSWORD=change-me        # openssl rand -hex 24
POSTGRES_DB=rbac
APP_DB_USER=rbac_app               # application role: row access only
APP_DB_PASSWORD=change-me          # openssl rand -hex 24

# --- Database URLs (hex passwords avoid URL-encoding issues) ---
MIGRATE_DATABASE_URL=postgres://rbac_owner:change-me@db:5432/rbac?sslmode=disable
DATABASE_URL=postgres://rbac_app:change-me@db:5432/rbac?sslmode=disable
# Managed DB: use sslmode=verify-full and the provider's CA bundle.

# --- Application ---
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=rbac-service
# JWT_SIGNING_KEY is provided as the Docker secret ./secrets/jwt_signing_key.
# JWT_VERIFICATION_KEYS=   # previous public keys during rotation (../docs/jwt.md)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SESSION_MAX_LIFETIME=720h
PUBLIC_REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=10
# HTTP_CORS_ALLOWED_ORIGINS=https://app.example.com
# SSO_STATE_KEY=           # >= 32 bytes, only when an SSO provider is registered

# --- Python service: concurrency ---
HTTP_WORKERS=0                     # worker processes; 0 = one per CPU (set explicitly in containers)
DB_MAX_OPEN_CONNS=10               # PER WORKER: total = HTTP_WORKERS x this (+ 1 for seeding)
DB_MAX_IDLE_CONNS=2                # connections each worker opens at startup
# DB_CONN_MAX_LIFETIME=30m         # connections older than this are replaced
# DB_POOL_TIMEOUT=10s              # max wait for a free pooled connection
PASSWORD_HASH_THREADS=2            # Argon2 threads per worker (~19 MiB each while hashing)
# HTTP_MAX_CONCURRENCY=1000        # per worker; beyond it answer 503 instead of queueing
# DB_STATEMENT_CACHE_SIZE=0        # set 0 behind PgBouncer in transaction mode
